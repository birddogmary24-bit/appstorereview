# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Batch update password - Salted SHA-256 hash (format: salt_hex:hash_hex)
# Generate: node -e "const c=require('crypto'),s=c.randomBytes(16),h=c.createHash('sha256').update(Buffer.concat([s,Buffer.from('YOUR_PASSWORD')])).digest('hex');console.log(s.toString('hex')+':'+h)"
UPDATE_PASSWORD_HASH=your_salt_hex:your_hash_hex

# Google Cloud Storage (production only)
GCS_BUCKET_NAME=your_bucket_name_here
GCS_BACKUP_BUCKET_NAME=your_backup_bucket_name_here

# Gemini speed mode: 'true' for paid tier (2s delay), 'false' for free tier (6s delay)
GEMINI_FAST_MODE=false
